<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.AdvancedDataWindow"
        x:DataType="coreVm:AdvancedDataViewModel"
        mc:Ignorable="d"
        d:DesignWidth="820"
        d:DesignHeight="620"
        Width="820"
        Height="620"
        MinWidth="620"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
  </Window.KeyBindings>

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Margin="18,18,18,8"
          ColumnDefinitions="260,*,120"
          ColumnSpacing="12">
      <TextBlock FontWeight="SemiBold" Text="{Binding KeyHeaderLabel}" />
      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ValueHeaderLabel}" />
      <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding LevelHeaderLabel}" />
    </Grid>

    <ScrollViewer Grid.Row="1"
                  Margin="18,0"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="coreVm:AdvancedDataKVLT">
            <Grid Margin="0,3"
                  ColumnDefinitions="260,*,120"
                  ColumnSpacing="12">
              <TextBlock VerticalAlignment="Center"
                         Text="{Binding Key}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding Key}" />
              <TextBox Grid.Column="1"
                       Text="{Binding Value, Mode=TwoWay}" />
              <TextBlock Grid.Column="2"
                         VerticalAlignment="Center"
                         Text="{Binding Level}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Padding="18,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel HorizontalAlignment="Right"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button MinWidth="90"
                Command="{Binding Apply}"
                Content="{Binding AppVM.ApplyLabel}" />
        <Button MinWidth="90"
                Command="{Binding Cancel}"
                Content="{Binding AppVM.CancelLabel}"
                IsCancel="True" />
        <Button MinWidth="90"
                Command="{Binding Accept}"
                Content="{Binding AppVM.AcceptLabel}"
                IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
