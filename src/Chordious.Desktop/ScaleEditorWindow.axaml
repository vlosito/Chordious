<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.ScaleEditorWindow"
        x:DataType="coreVm:ScaleEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="700"
        d:DesignHeight="330"
        Width="700"
        SizeToContent="Height"
        MinWidth="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Opened="Window_Opened"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
  </Window.KeyBindings>

  <Grid Margin="20"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        RowSpacing="14">
    <StackPanel Spacing="5">
      <TextBlock FontWeight="SemiBold" Text="{Binding NameLabel}" />
      <TextBox x:Name="NameTextBox"
               AutomationProperties.HelpText="{Binding NameToolTip}"
               AutomationProperties.Name="{Binding NameLabel}"
               IsReadOnly="{Binding ReadOnly}"
               Text="{Binding Name, Mode=TwoWay}"
               ToolTip.Tip="{Binding NameToolTip}" />
    </StackPanel>

    <Grid Grid.Row="1"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="12">
      <StackPanel Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="{Binding IntervalsLabel}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button MinWidth="38"
                  Command="{Binding AddInterval}"
                  Content="{Binding AddIntervalLabel}"
                  ToolTip.Tip="{Binding AddIntervalToolTip}" />
          <Button MinWidth="38"
                  Command="{Binding RemoveInterval}"
                  Content="{Binding RemoveIntervalLabel}"
                  ToolTip.Tip="{Binding RemoveIntervalToolTip}" />
        </StackPanel>
      </StackPanel>

      <ItemsControl Grid.Column="1"
                    ItemsSource="{Binding Intervals}"
                    IsEnabled="{Binding !ReadOnly}"
                    ToolTip.Tip="{Binding IntervalsToolTip}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"
                       ItemSpacing="8"
                       LineSpacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="coreVm:NamedIntervalValue">
            <NumericUpDown Width="76"
                           AutomationProperties.HelpText="{Binding ValueToolTip}"
                           AutomationProperties.Name="Intervalo"
                           Minimum="0"
                           Increment="1"
                           FormatString="0"
                           Value="{Binding Value, Mode=TwoWay}"
                           ToolTip.Tip="{Binding ValueToolTip}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Border Grid.Row="2"
            Padding="12"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="{Binding ExampleLabel}" />
        <TextBlock Text="{Binding Example}"
                   TextWrapping="Wrap"
                   ToolTip.Tip="{Binding ExampleToolTip}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="3"
            Padding="10"
            IsVisible="{Binding ReadOnly}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="6">
      <TextBlock Text="Esta escala pertence à configuração padrão e pode apenas ser consultada."
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="4"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button MinWidth="90"
              Command="{Binding Cancel}"
              Content="{Binding AppVM.CancelLabel}"
              HorizontalContentAlignment="Center"
              IsCancel="True" />
      <Button MinWidth="90"
              Command="{Binding Accept}"
              Content="{Binding AppVM.AcceptLabel}"
              HorizontalContentAlignment="Center"
              IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
