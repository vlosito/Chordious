<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.DiagramBarreEditorWindow"
        x:DataType="coreVm:DiagramBarreEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="760"
        d:DesignHeight="520"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Grid RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
    <Border Padding="22,16" Background="{DynamicResource AccentColor100}">
      <StackPanel Spacing="2">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Editor de pestana" />
        <TextBlock Opacity="0.75"
                   Text="Traçado, visibilidade e empilhamento usando o ViewModel compartilhado" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <Grid Margin="20" ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding Style.IsEditable}">
        <Border Padding="14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel Spacing="12">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Estilo da pestana" />

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Curvatura local"
                        IsChecked="{Binding Style.BarreArcRatioIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Proporção" />
              <NumericUpDown Grid.Column="2"
                             Minimum="0"
                             Maximum="4"
                             Increment="0.01"
                             FormatString="0.00"
                             Value="{Binding Style.BarreArcRatio, Mode=TwoWay}"
                             IsEnabled="{Binding Style.BarreArcRatioIsLocal}" />
            </Grid>

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Opacidade local"
                        IsChecked="{Binding Style.BarreOpacityIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Opacidade" />
              <NumericUpDown Grid.Column="2"
                             Minimum="0"
                             Maximum="1"
                             Increment="0.01"
                             FormatString="0.00"
                             Value="{Binding Style.BarreOpacity, Mode=TwoWay}"
                             IsEnabled="{Binding Style.BarreOpacityIsLocal}" />
            </Grid>

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Cor local"
                        IsChecked="{Binding Style.BarreLineColorIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Cor" />
              <TextBox Grid.Column="2"
                       PlaceholderText="#RRGGBB"
                       Text="{Binding Style.BarreLineColor, Mode=TwoWay}"
                       IsEnabled="{Binding Style.BarreLineColorIsLocal}" />
            </Grid>

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Espessura local"
                        IsChecked="{Binding Style.BarreLineThicknessIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Pixels" />
              <NumericUpDown Grid.Column="2"
                             Minimum="0"
                             Increment="0.25"
                             FormatString="0.00"
                             Value="{Binding Style.BarreLineThickness, Mode=TwoWay}"
                             IsEnabled="{Binding Style.BarreLineThicknessIsLocal}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Padding="14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <StackPanel Spacing="12">
            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Layout da pestana" />

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Visibilidade local"
                        IsChecked="{Binding Style.BarreVisibleIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Visível" />
              <CheckBox Grid.Column="2"
                        IsChecked="{Binding Style.BarreVisible, Mode=TwoWay}"
                        IsEnabled="{Binding Style.BarreVisibleIsLocal}" />
            </Grid>

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Alinhamento local"
                        IsChecked="{Binding Style.BarreVerticalAlignmentIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Alinhamento" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding Style.BarreVerticalAlignments}"
                        SelectedIndex="{Binding Style.SelectedBarreVerticalAlignmentIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Style.BarreVerticalAlignmentIsLocal}" />
            </Grid>

            <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
              <CheckBox Content="Camada local"
                        IsChecked="{Binding Style.BarreStackIsLocal, Mode=TwoWay}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Empilhamento" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding Style.BarreStacks}"
                        SelectedIndex="{Binding Style.SelectedBarreStackIndex, Mode=TwoWay}"
                        IsEnabled="{Binding Style.BarreStackIsLocal}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Button Command="{Binding Style.Reset}" Content="Restaurar estilo" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Opacity="0.65"
                   Text="Alterações são aplicadas somente ao confirmar." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button MinWidth="90" Command="{Binding Apply}" Content="Aplicar" />
          <Button MinWidth="90" Command="{Binding Cancel}" Content="Cancelar" />
          <Button MinWidth="90" Command="{Binding Accept}" Content="Salvar" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
