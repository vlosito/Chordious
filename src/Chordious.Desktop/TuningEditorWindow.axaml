<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.TuningEditorWindow"
        x:DataType="coreVm:TuningEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="760"
        d:DesignHeight="330"
        Width="760"
        SizeToContent="Height"
        MinWidth="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Opened="Window_Opened"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
  </Window.KeyBindings>

  <Grid Margin="20"
        RowDefinitions="Auto,Auto,Auto,Auto"
        RowSpacing="14">
    <StackPanel Spacing="5">
      <TextBlock FontWeight="SemiBold" Text="{Binding NameLabel}" />
      <TextBox x:Name="NameTextBox"
               IsReadOnly="{Binding ReadOnly}"
               Text="{Binding Name, Mode=TwoWay}"
               ToolTip.Tip="{Binding NameToolTip}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="{Binding RootNotesLabel}" />
      <ItemsControl ItemsSource="{Binding RootNotes}"
                    IsEnabled="{Binding !ReadOnly}"
                    ToolTip.Tip="{Binding RootNotesToolTip}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"
                       ItemSpacing="10"
                       LineSpacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="coreVm:ObservableNote">
            <Border Padding="10"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
              <Grid ColumnDefinitions="110,72"
                    ColumnSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding SelectedNoteLabel}" />
                  <ComboBox ItemsSource="{Binding Notes}"
                            SelectedIndex="{Binding SelectedNoteIndex, Mode=TwoWay}"
                            ToolTip.Tip="{Binding SelectedNoteToolTip}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{Binding OctaveLabel}" />
                  <NumericUpDown Minimum="0"
                                 Increment="1"
                                 FormatString="0"
                                 Value="{Binding Octave, Mode=TwoWay}"
                                 ToolTip.Tip="{Binding OctaveToolTip}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border Grid.Row="2"
            Padding="10"
            IsVisible="{Binding ReadOnly}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="6">
      <TextBlock Text="Esta afinação pertence à configuração padrão e pode apenas ser consultada."
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button MinWidth="90"
              Command="{Binding Cancel}"
              Content="{Binding AppVM.CancelLabel}"
              HorizontalContentAlignment="Center"
              IsCancel="True" />
      <Button MinWidth="90"
              Command="{Binding Accept}"
              Content="{Binding AppVM.AcceptLabel}"
              HorizontalContentAlignment="Center"
              IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
