<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Chordious.Desktop</AssemblyName>
    <RootNamespace>Chordious.Desktop</RootNamespace>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chordious.Core\Chordious.Core.csproj" />
    <ProjectReference Include="..\Chordious.Core.ViewModel\Chordious.Core.ViewModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\Chordious.WPF\Resources\chordious128.png"
                      Link="Assets\chordious128.png" />
    <EmbeddedResource Include="..\Chordious.WPF\Chordious.WPF.xml"
                      Link="Resources\Chordious.Desktop.xml"
                      LogicalName="Chordious.Desktop.Chordious.Desktop.xml" />
    <InternalsVisibleTo Include="Chordious.DesktopTest" />
    <None Update="Info.plist">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
