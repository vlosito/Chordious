<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.InstrumentEditorWindow"
        x:DataType="coreVm:InstrumentEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="230"
        Width="520"
        SizeToContent="Height"
        MinWidth="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Opened="Window_Opened"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Cancel}" />
  </Window.KeyBindings>

  <Grid Margin="20"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="14">
    <Grid ColumnDefinitions="*,140"
          ColumnSpacing="14">
      <StackPanel Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="{Binding NameLabel}" />
        <TextBox x:Name="NameTextBox"
                 IsReadOnly="{Binding ReadOnly}"
                 Text="{Binding Name, Mode=TwoWay}"
                 ToolTip.Tip="{Binding NameToolTip}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="5">
        <TextBlock FontWeight="SemiBold" Text="{Binding NumStringsLabel}" />
        <NumericUpDown Minimum="2"
                       Increment="1"
                       FormatString="0"
                       IsEnabled="{Binding IsNew}"
                       Value="{Binding NumStrings, Mode=TwoWay}"
                       ToolTip.Tip="{Binding NumStringsToolTip}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1"
            Padding="10"
            IsVisible="{Binding ReadOnly}"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="6">
      <TextBlock Text="Este instrumento pertence à configuração padrão e pode apenas ser consultado."
                 TextWrapping="Wrap" />
    </Border>

    <StackPanel Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
      <Button MinWidth="90"
              Command="{Binding Cancel}"
              Content="{Binding AppVM.CancelLabel}"
              HorizontalContentAlignment="Center"
              IsCancel="True" />
      <Button MinWidth="90"
              Command="{Binding Accept}"
              Content="{Binding AppVM.AcceptLabel}"
              HorizontalContentAlignment="Center"
              IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
