<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.DiagramEditorWindow"
        x:DataType="coreVm:DiagramEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="620"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Grid RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
    <Border Padding="22,16" Background="{DynamicResource AccentColor100}">
      <StackPanel Spacing="2">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Editor de diagrama" />
        <TextBlock Opacity="0.75" Text="Título, dimensões e preview usando o ViewModel compartilhado" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1"
          Margin="20"
          ColumnDefinitions="300,*"
          ColumnSpacing="20">
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="14">
          <Border Padding="14"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Spacing="10">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Conteúdo" />
              <TextBlock Text="Título" />
              <TextBox Text="{Binding ObservableDiagram.Title, Mode=TwoWay}" />
            </StackPanel>
          </Border>

          <Border Padding="14"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,110"
                  RowSpacing="10"
                  ColumnSpacing="10">
              <TextBlock Grid.ColumnSpan="2"
                         FontSize="17"
                         FontWeight="SemiBold"
                         Text="Dimensões" />

              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Cordas" />
              <NumericUpDown Grid.Row="1"
                             Grid.Column="1"
                             Minimum="2"
                             Maximum="24"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding ObservableDiagram.NumStrings, Mode=TwoWay}" />

              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Casas" />
              <NumericUpDown Grid.Row="2"
                             Grid.Column="1"
                             Minimum="1"
                             Maximum="36"
                             Increment="1"
                             FormatString="0"
                             Value="{Binding ObservableDiagram.NumFrets, Mode=TwoWay}" />

              <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Largura renderizada" />
              <TextBlock Grid.Row="3"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Text="{Binding ObservableDiagram.TotalWidth}" />

              <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Altura renderizada" />
              <TextBlock Grid.Row="4"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Text="{Binding ObservableDiagram.TotalHeight}" />
            </Grid>
          </Border>

          <Border Padding="14"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Disponível nesta fatia" />
              <TextBlock Text="✓ Criar e editar diagramas" />
              <TextBlock Text="✓ Título, cordas e casas" />
              <TextBlock Text="✓ Preview, persistência e marcas" />
              <TextBlock Opacity="0.65"
                         Text="Selecione uma posição no diagrama e use os botões de marca ou o menu de contexto. Pestanas, rótulos e estilos serão adicionados nos próximos incrementos."
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1"
              Padding="18"
              Background="White"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <StackPanel>
            <TextBlock Foreground="Black"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Preview" />
            <TextBlock Foreground="#6A6A6A"
                       Text="Selecione uma posição para editar marcas" />
          </StackPanel>
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <Image Name="DiagramImage"
                   Margin="18"
                   Width="{Binding ObservableDiagram.TotalWidth}"
                   Height="{Binding ObservableDiagram.TotalHeight}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   DoubleTapped="DiagramImage_DoubleTapped"
                   PointerPressed="DiagramImage_PointerPressed"
                   Source="{Binding ObservableDiagram.ImageObject}"
                   Stretch="Fill">
              <Image.ContextMenu>
                <ContextMenu>
                  <MenuItem Command="{Binding ObservableDiagram.AddMark}"
                            Header="Adicionar marca…"
                            IsVisible="{Binding ObservableDiagram.CanAddMark}" />
                  <MenuItem Command="{Binding ObservableDiagram.EditMark}"
                            Header="Editar marca…"
                            IsVisible="{Binding ObservableDiagram.CanEditMark}" />
                  <MenuItem Command="{Binding ObservableDiagram.RemoveMark}"
                            Header="Remover marca"
                            IsVisible="{Binding ObservableDiagram.CanRemoveMark}" />
                </ContextMenu>
              </Image.ContextMenu>
            </Image>
          </ScrollViewer>
          <StackPanel Grid.Row="2"
                      HorizontalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="8">
            <Button Command="{Binding ObservableDiagram.AddMark}"
                    Content="Adicionar marca…"
                    IsEnabled="{Binding ObservableDiagram.CanAddMark}" />
            <Button Command="{Binding ObservableDiagram.EditMark}"
                    Content="Editar marca…"
                    IsEnabled="{Binding ObservableDiagram.CanEditMark}" />
            <Button Command="{Binding ObservableDiagram.RemoveMark}"
                    Content="Remover marca"
                    IsEnabled="{Binding ObservableDiagram.CanRemoveMark}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Padding="20,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Button Command="{Binding ResetStyles}" Content="Restaurar estilos" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Opacity="0.65"
                   Text="Alterações são aplicadas somente ao confirmar." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button MinWidth="90" Command="{Binding Apply}" Content="Aplicar" />
          <Button MinWidth="90" Command="{Binding Cancel}" Content="Cancelar" />
          <Button MinWidth="90" Command="{Binding Accept}" Content="Salvar" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
