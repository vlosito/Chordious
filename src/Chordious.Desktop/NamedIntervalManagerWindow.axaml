<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.NamedIntervalManagerWindow"
        x:DataType="coreVm:NamedIntervalManagerViewModel"
        mc:Ignorable="d"
        d:DesignWidth="680"
        d:DesignHeight="620"
        Width="680"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Close}" />
  </Window.KeyBindings>

  <Grid Margin="18"
        RowDefinitions="*,*,Auto"
        RowSpacing="14">
    <Border Padding="12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock FontSize="16"
                     FontWeight="SemiBold"
                     Text="{Binding UserNamedIntervalGroupLabel}" />
          <TextBlock Opacity="0.7"
                     Text="Itens personalizados podem ser alterados ou excluídos." />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding UserNamedIntervals}"
                 SelectedIndex="{Binding SelectedUserNamedIntervalIndex, Mode=TwoWay}"
                 DoubleTapped="NamedIntervalList_DoubleTapped"
                 KeyDown="NamedIntervalList_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="coreVm:ObservableNamedInterval">
              <TextBlock Text="{Binding LongName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Command="{Binding AddNamedInterval}"
                        Header="{Binding AddNamedIntervalLabel}" />
              <MenuItem Command="{Binding EditNamedInterval}"
                        Header="{Binding EditNamedIntervalLabel}" />
              <MenuItem Command="{Binding DeleteNamedInterval}"
                        Header="{Binding DeleteNamedIntervalLabel}" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>

        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   ItemSpacing="8">
          <Button Command="{Binding AddNamedInterval}"
                  Content="{Binding AddNamedIntervalLabel}"
                  ToolTip.Tip="{Binding AddNamedIntervalToolTip}" />
          <Button Command="{Binding EditNamedInterval}"
                  Content="{Binding EditNamedIntervalLabel}"
                  ToolTip.Tip="{Binding EditNamedIntervalToolTip}" />
          <Button Command="{Binding DeleteNamedInterval}"
                  Content="{Binding DeleteNamedIntervalLabel}"
                  ToolTip.Tip="{Binding DeleteNamedIntervalToolTip}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Padding="12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock FontSize="16"
                     FontWeight="SemiBold"
                     Text="{Binding DefaultNamedIntervalGroupLabel}" />
          <TextBlock Opacity="0.7"
                     Text="Itens padrão são somente leitura." />
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding DefaultNamedIntervals}"
                 SelectedIndex="{Binding SelectedDefaultNamedIntervalIndex, Mode=TwoWay}"
                 DoubleTapped="NamedIntervalList_DoubleTapped"
                 KeyDown="NamedIntervalList_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="coreVm:ObservableNamedInterval">
              <TextBlock Text="{Binding LongName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Button Grid.Row="2"
            HorizontalAlignment="Right"
            MinWidth="100"
            Command="{Binding Close}"
            Content="Fechar"
            HorizontalContentAlignment="Center" />
  </Grid>
</Window>
