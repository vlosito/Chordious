<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Chordious.Desktop.ViewModels"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="640"
        Width="980"
        Height="640"
        MinWidth="820"
        MinHeight="540"
        Opened="Window_Opened"
        PointerMoved="Window_PointerMoved"
        PointerReleased="Window_PointerReleased"
        Title="Chordious">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Arquivo">
        <NativeMenu>
          <NativeMenuItem Header="Fechar janela"
                          Click="CloseWindow_OnClick"
                          Gesture="Meta+W" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Editar">
        <NativeMenu>
          <NativeMenuItem Header="Copiar SVG do diagrama"
                          Command="{Binding CopySelectedDiagramSvgCommand}"
                          Gesture="Meta+Shift+C" />
          <NativeMenuItem Header="Copiar imagem do diagrama"
                          Command="{Binding CopySelectedDiagramImageCommand}"
                          Gesture="Meta+Alt+C" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Biblioteca">
        <NativeMenu>
          <NativeMenuItem Header="Novo diagrama"
                          Command="{Binding SelectedLibraryNode.CreateDiagram}"
                          Gesture="Meta+N" />
          <NativeMenuItem Header="Editar diagrama selecionado"
                          Command="{Binding SelectedLibraryNode.EditSelected}"
                          Gesture="Meta+E" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Exportar diagrama selecionado…"
                          Command="{Binding SelectedLibraryNode.ExportSelected}"
                          Gesture="Meta+Shift+E" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Ferramentas">
        <NativeMenu>
          <NativeMenuItem Header="Chord Finder"
                          Command="{Binding ShowChordFinder}"
                          Gesture="Meta+F" />
          <NativeMenuItem Header="Scale Finder"
                          Command="{Binding ShowScaleFinder}"
                          Gesture="Meta+Shift+F" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Instrumentos e afinações…"
                          Command="{Binding ShowInstrumentManager}" />
          <NativeMenuItem Header="Qualidades de acordes…"
                          Command="{Binding ShowChordQualityManager}" />
          <NativeMenuItem Header="Escalas…"
                          Command="{Binding ShowScaleManager}" />
        </NativeMenu>
      </NativeMenuItem>
      <NativeMenuItem Header="Ajuda">
        <NativeMenu>
          <NativeMenuItem Header="Ajuda do Chordious"
                          Command="{Binding ShowHelp}" />
          <NativeMenuItem Header="Website do Chordious"
                          Command="{Binding LaunchWebsite}" />
          <NativeMenuItemSeparator />
          <NativeMenuItem Header="Licenças…"
                          Command="{Binding ShowLicenses}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>

  <Grid RowDefinitions="Auto,*" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
    <Border Grid.Row="0"
            Padding="24,18"
            Background="{DynamicResource AccentColor100}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <Image Width="52"
               Height="52"
               AutomationProperties.Name="Ícone do Chordious"
               Source="avares://Chordious.Desktop/Assets/chordious128.png" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock AutomationProperties.HeadingLevel="1"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Text="Chordious para macOS" />
          <TextBlock Opacity="0.75" Text="Core e ViewModels compartilhados com interface Avalonia nativa" />
        </StackPanel>
        <Border Grid.Column="2"
                Padding="12,6"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="14">
          <TextBlock FontWeight="SemiBold" Text="Fase 5 · Paridade de plataforma" />
        </Border>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs"
                Grid.Row="1"
                Margin="18"
                AutomationProperties.AutomationId="MainTabs"
                AutomationProperties.Name="Áreas principais do Chordious"
                TabIndex="0">
      <TabItem Header="Visão geral">
        <Grid Margin="6"
              ColumnDefinitions="340,*"
              ColumnSpacing="24">
          <ScrollViewer Grid.Column="0"
                        AutomationProperties.LandmarkType="Navigation"
                        VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14">
            <TextBlock AutomationProperties.HeadingLevel="2"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Text="Baseline funcional" />

            <Border Padding="16"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <StackPanel Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="Disponível neste incremento" />
                <TextBlock Text="✓ Inicialização nativa no macOS" />
                <TextBlock Text="✓ Configuração padrão e de usuário" />
                <TextBlock Text="✓ MainViewModel compartilhado" />
                <TextBlock Text="✓ Diagrama gerado pelo Chordious.Core" />
                <TextBlock Text="✓ Renderização SVG com Skia" />
                <TextBlock Text="✓ Exportação SVG por diálogo nativo" />
                <TextBlock Text="✓ Exportação em lote SVG, PNG, GIF e JPG" />
                <TextBlock Text="✓ Escala e nomes de arquivo parametrizados" />
                <TextBlock Text="✓ Navegação e CRUD de coleções" />
                <TextBlock Text="✓ Copiar, mover e mesclar coleções e diagramas" />
                <TextBlock Text="✓ Chord Finder com resultados reais" />
                <TextBlock Text="✓ Scale Finder com resultados reais" />
                <TextBlock Text="✓ Instrumentos e afinações" />
                <TextBlock Text="✓ Qualidades de acordes e intervalos" />
                <TextBlock Text="✓ Escalas e intervalos" />
                <TextBlock Text="✓ Preferências e configuração" />
                <TextBlock Text="✓ Ajuda, website e licenças" />
              </StackPanel>
            </Border>

            <Button x:Name="ShowChordFinderButton"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AcceleratorKey="Cmd+F"
                    AutomationProperties.AutomationId="ShowChordFinderButton"
                    AutomationProperties.HelpText="{Binding ShowChordFinderToolTip}"
                    AutomationProperties.Name="Abrir Chord Finder"
                    Command="{Binding ShowChordFinder}"
                    Content="{Binding ShowChordFinderLabel}"
                    TabIndex="1"
                    ToolTip.Tip="{Binding ShowChordFinderToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AcceleratorKey="Cmd+Shift+F"
                    AutomationProperties.AutomationId="ShowScaleFinderButton"
                    AutomationProperties.HelpText="{Binding ShowScaleFinderToolTip}"
                    AutomationProperties.Name="Abrir Scale Finder"
                    Command="{Binding ShowScaleFinder}"
                    Content="{Binding ShowScaleFinderLabel}"
                    TabIndex="2"
                    ToolTip.Tip="{Binding ShowScaleFinderToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShowInstrumentManagerButton"
                    AutomationProperties.HelpText="{Binding ShowInstrumentManagerToolTip}"
                    AutomationProperties.Name="Gerenciar instrumentos e afinações"
                    Command="{Binding ShowInstrumentManager}"
                    Content="{Binding ShowInstrumentManagerLabel}"
                    TabIndex="3"
                    ToolTip.Tip="{Binding ShowInstrumentManagerToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShowChordQualityManagerButton"
                    AutomationProperties.HelpText="{Binding ShowChordQualityManagerToolTip}"
                    AutomationProperties.Name="Gerenciar qualidades de acordes"
                    Command="{Binding ShowChordQualityManager}"
                    Content="{Binding ShowChordQualityManagerLabel}"
                    TabIndex="4"
                    ToolTip.Tip="{Binding ShowChordQualityManagerToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShowScaleManagerButton"
                    AutomationProperties.HelpText="{Binding ShowScaleManagerToolTip}"
                    AutomationProperties.Name="Gerenciar escalas"
                    Command="{Binding ShowScaleManager}"
                    Content="{Binding ShowScaleManagerLabel}"
                    TabIndex="5"
                    ToolTip.Tip="{Binding ShowScaleManagerToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AcceleratorKey="Cmd+,"
                    AutomationProperties.AutomationId="ShowOptionsButton"
                    AutomationProperties.HelpText="{Binding ShowOptionsToolTip}"
                    AutomationProperties.Name="Abrir ajustes do Chordious"
                    Command="{Binding ShowOptions}"
                    Content="{Binding ShowOptionsLabel}"
                    TabIndex="6"
                    ToolTip.Tip="{Binding ShowOptionsToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="LaunchWebsiteButton"
                    AutomationProperties.HelpText="{Binding LaunchWebsiteToolTip}"
                    AutomationProperties.Name="Abrir website do Chordious"
                    Command="{Binding LaunchWebsite}"
                    Content="{Binding LaunchWebsiteLabel}"
                    TabIndex="7"
                    ToolTip.Tip="{Binding LaunchWebsiteToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShowHelpButton"
                    AutomationProperties.HelpText="{Binding ShowHelpToolTip}"
                    AutomationProperties.Name="Abrir ajuda do Chordious"
                    Command="{Binding ShowHelp}"
                    Content="{Binding ShowHelpLabel}"
                    TabIndex="8"
                    ToolTip.Tip="{Binding ShowHelpToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ShowLicensesButton"
                    AutomationProperties.HelpText="{Binding ShowLicensesToolTip}"
                    AutomationProperties.Name="Exibir licenças"
                    Command="{Binding ShowLicenses}"
                    Content="{Binding ShowLicensesLabel}"
                    TabIndex="9"
                    ToolTip.Tip="{Binding ShowLicensesToolTip}" />

            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    AutomationProperties.AutomationId="ExportPreviewSvgButton"
                    AutomationProperties.Name="Exportar diagrama de exemplo como SVG"
                    Command="{Binding ExportPreviewSvgCommand}"
                    Content="Exportar preview como SVG"
                    TabIndex="10" />

            <TextBlock AutomationProperties.LiveSetting="Polite"
                       Text="{Binding ExportStatus}"
                       TextWrapping="Wrap"
                       Opacity="0.8" />

            <Border Padding="16"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="Próximos fluxos" />
                <TextBlock Text="1. Corpus real de compatibilidade 2.8.0" />
                <TextBlock Text="2. Integrações e validações macOS" />
                <TextBlock Text="3. Atualização e distribuição assinada" />
              </StackPanel>
            </Border>
          </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1"
                  Padding="20"
                  Background="White"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="14">
              <StackPanel Grid.Row="0" Spacing="2">
                <TextBlock Foreground="Black"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Preview real do domínio" />
                <TextBlock Foreground="#6A6A6A"
                           Text="{Binding PreviewDiagram.Title}" />
              </StackPanel>
              <Image Grid.Row="1"
                     Margin="24"
                     AutomationProperties.AutomationId="OverviewDiagramPreview"
                     AutomationProperties.Name="Preview do diagrama de exemplo"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Source="{Binding PreviewDiagram.ImageObject}"
                     Stretch="Uniform" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Biblioteca">
        <Grid Margin="6"
              ColumnDefinitions="230,280,*"
              ColumnSpacing="14">
          <Border Padding="12"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Coleções" />
                <TextBlock Opacity="0.65" Text="Arquivo de usuário existente" />
              </StackPanel>
              <ListBox Grid.Row="1"
                       AutomationProperties.AutomationId="LibraryCollectionsList"
                       AutomationProperties.HelpText="Selecione uma coleção para listar e gerenciar seus diagramas."
                       AutomationProperties.Name="Coleções da biblioteca"
                       ItemsSource="{Binding Library.Nodes}"
                       SelectionChanged="LibraryNodesListBox_SelectionChanged"
                       SelectedItem="{Binding SelectedLibraryNode, Mode=TwoWay}"
                       DragDrop.AllowDrop="True"
                       DragDrop.DragOver="LibraryDropTarget_DragOver"
                       DragDrop.Drop="LibraryNodesListBox_Drop"
                       TabIndex="1">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="coreVm:ObservableDiagramLibraryNode">
                    <StackPanel Margin="4"
                                Spacing="2"
                                PointerPressed="LibraryNode_PointerPressed"
                                DragDrop.AllowDrop="True"
                                DragDrop.DragOver="LibraryDropTarget_DragOver"
                                DragDrop.Drop="LibraryNode_Drop">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Path}" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Grid.Row="2" ItemSpacing="6" LineSpacing="6">
                <Button Command="{Binding Library.CreateNode}" Content="Nova" />
                <Button Command="{Binding Library.EditNode}" Content="Renomear" />
                <Button Command="{Binding Library.CloneNode}" Content="Clonar" />
                <Button Command="{Binding Library.CopyNode}" Content="Copiar…" />
                <Button Command="{Binding Library.MergeNode}" Content="Mesclar…" />
                <Button Command="{Binding Library.DeleteNode}" Content="Excluir" />
                <Button Command="{Binding Library.EditNodeStyle}" Content="Estilo…" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border Grid.Column="1"
                  Padding="12"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
              <StackPanel>
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Diagramas" />
                <TextBlock Opacity="0.65" Text="Selecione um item para visualizar" />
              </StackPanel>
              <ListBox x:Name="DiagramsListBox"
                       Grid.Row="1"
                       AutomationProperties.AutomationId="LibraryDiagramsList"
                       AutomationProperties.HelpText="Selecione um ou mais diagramas para editar, copiar, mover ou exportar."
                       AutomationProperties.Name="Diagramas da coleção selecionada"
                       ItemsSource="{Binding SelectedLibraryNode.Diagrams}"
                       SelectionChanged="DiagramsListBox_SelectionChanged"
                       SelectionMode="Multiple"
                       DragDrop.AllowDrop="True"
                       DragDrop.DragOver="LibraryDropTarget_DragOver"
                       DragDrop.Drop="DiagramsListBox_Drop"
                       TabIndex="2">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="coreVm:ObservableDiagram">
                    <Grid Margin="4" ColumnDefinitions="56,*" ColumnSpacing="8">
                      <Image Width="52"
                             Height="52"
                             Source="{Binding ImageObject}"
                             Stretch="Uniform"
                             PointerPressed="LibraryDiagram_PointerPressed" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock FontSize="11" Opacity="0.6" Text="{Binding Name}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Grid.Row="2" ItemSpacing="6" LineSpacing="6">
                <Button Command="{Binding SelectedLibraryNode.CreateDiagram}" Content="Novo" />
                <Button Command="{Binding SelectedLibraryNode.EditSelected}" Content="Editar" />
                <Button Command="{Binding SelectedLibraryNode.CloneSelected}" Content="Clonar" />
                <Button Command="{Binding SelectedLibraryNode.CopySelected}" Content="Copiar…" />
                <Button Command="{Binding SelectedLibraryNode.MoveSelected}" Content="Mover…" />
                <Button Command="{Binding SelectedLibraryNode.ResetStylesSelected}" Content="Redefinir estilos" />
                <Button Command="{Binding SelectedLibraryNode.DeleteSelected}" Content="Excluir" />
              </WrapPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2"
                  Padding="16"
                  Background="White"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
              <StackPanel>
                <TextBlock Foreground="Black"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Preview da biblioteca" />
                <TextBlock Foreground="#6A6A6A" Text="{Binding PreviewDiagram.Title}" />
              </StackPanel>
              <Image Grid.Row="1"
                     Margin="16"
                     AutomationProperties.AutomationId="LibraryDiagramPreview"
                     AutomationProperties.Name="Preview do diagrama selecionado"
                     Source="{Binding PreviewDiagram.ImageObject}"
                     Stretch="Uniform" />
              <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8">
                <Button Command="{Binding SelectedLibraryNode.ExportSelected}" Content="Exportar…" />
                <Button Command="{Binding CopySelectedDiagramSvgCommand}" Content="Copiar SVG" />
                <Button Command="{Binding CopySelectedDiagramImageCommand}" Content="Copiar imagem" />
              </WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
