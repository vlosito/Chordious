<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.InstrumentManagerWindow"
        x:DataType="coreVm:InstrumentManagerViewModel"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="620"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding Close}" />
  </Window.KeyBindings>

  <Grid Margin="18"
        ColumnDefinitions="320,*"
        RowDefinitions="*,Auto"
        ColumnSpacing="14"
        RowSpacing="14">
    <Grid RowDefinitions="*,*"
          RowSpacing="14">
      <Border Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding UserInstrumentsGroupLabel}" />
            <TextBlock Opacity="0.7"
                       Text="Instrumentos personalizados podem ser alterados ou excluídos." />
          </StackPanel>

          <ListBox x:Name="UserInstrumentsListBox"
                   Grid.Row="1"
                   ItemsSource="{Binding UserInstruments}"
                   SelectedIndex="{Binding SelectedUserInstrumentIndex, Mode=TwoWay}"
                   DoubleTapped="InstrumentList_DoubleTapped"
                   KeyDown="InstrumentList_KeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="coreVm:ObservableInstrument">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1"
                             Opacity="0.65"
                             Text="{Binding NumStrings, StringFormat='{}{0} cordas'}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Command="{Binding AddInstrument}"
                          Header="{Binding AddInstrumentLabel}" />
                <MenuItem Command="{Binding EditInstrument}"
                          Header="{Binding EditInstrumentLabel}" />
                <MenuItem Command="{Binding DeleteInstrument}"
                          Header="{Binding DeleteInstrumentLabel}" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>

          <WrapPanel Grid.Row="2"
                     HorizontalAlignment="Center"
                     ItemSpacing="8">
            <Button Command="{Binding AddInstrument}"
                    Content="{Binding AddInstrumentLabel}"
                    ToolTip.Tip="{Binding AddInstrumentToolTip}" />
            <Button Command="{Binding EditInstrument}"
                    Content="{Binding EditInstrumentLabel}"
                    ToolTip.Tip="{Binding EditInstrumentToolTip}" />
            <Button Command="{Binding DeleteInstrument}"
                    Content="{Binding DeleteInstrumentLabel}"
                    ToolTip.Tip="{Binding DeleteInstrumentToolTip}" />
          </WrapPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Padding="12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <StackPanel Spacing="2">
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding DefaultInstrumentsGroupLabel}" />
            <TextBlock Opacity="0.7"
                       Text="Instrumentos padrão são somente leitura." />
          </StackPanel>

          <ListBox x:Name="DefaultInstrumentsListBox"
                   Grid.Row="1"
                   ItemsSource="{Binding DefaultInstruments}"
                   SelectedIndex="{Binding SelectedDefaultInstrumentIndex, Mode=TwoWay}"
                   DoubleTapped="InstrumentList_DoubleTapped"
                   KeyDown="InstrumentList_KeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="coreVm:ObservableInstrument">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Grid.Column="1"
                             Opacity="0.65"
                             Text="{Binding NumStrings, StringFormat='{}{0} cordas'}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Column="1"
            Padding="12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="2">
          <TextBlock FontSize="16"
                     FontWeight="SemiBold"
                     Text="{Binding TuningsGroupLabel}" />
          <TextBlock Opacity="0.7"
                     Text="Selecione um instrumento para gerenciar suas afinações." />
        </StackPanel>

        <ListBox x:Name="TuningsListBox"
                 Grid.Row="1"
                 IsEnabled="{Binding InstrumentIsSelected}"
                 ItemsSource="{Binding Tunings}"
                 SelectedItem="{Binding SelectedTuning, Mode=TwoWay}"
                 DoubleTapped="TuningList_DoubleTapped"
                 KeyDown="TuningList_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="coreVm:ObservableTuning">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Opacity="0.68" Text="{Binding LongName}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ReadOnly}"
                           Opacity="0.65"
                           Text="Somente leitura" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Command="{Binding AddTuning}"
                        Header="{Binding AddTuningLabel}" />
              <MenuItem Command="{Binding EditTuning}"
                        Header="{Binding EditTuningLabel}" />
              <MenuItem Command="{Binding CopyTuning}"
                        Header="{Binding CopyTuningLabel}" />
              <MenuItem Command="{Binding DeleteTuning}"
                        Header="{Binding DeleteTuningLabel}" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>

        <WrapPanel Grid.Row="2"
                   HorizontalAlignment="Center"
                   ItemSpacing="8"
                   LineSpacing="8">
          <Button Command="{Binding AddTuning}"
                  Content="{Binding AddTuningLabel}"
                  ToolTip.Tip="{Binding AddTuningToolTip}" />
          <Button Command="{Binding EditTuning}"
                  Content="{Binding EditTuningLabel}"
                  ToolTip.Tip="{Binding EditTuningToolTip}" />
          <Button Command="{Binding CopyTuning}"
                  Content="{Binding CopyTuningLabel}"
                  ToolTip.Tip="{Binding CopyTuningToolTip}" />
          <Button Command="{Binding DeleteTuning}"
                  Content="{Binding DeleteTuningLabel}"
                  ToolTip.Tip="{Binding DeleteTuningToolTip}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Button Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            MinWidth="100"
            Command="{Binding Close}"
            Content="Fechar"
            HorizontalContentAlignment="Center"
            IsCancel="True" />
  </Grid>
</Window>
