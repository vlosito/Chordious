<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:coreVm="using:Chordious.Core.ViewModel"
        x:Class="Chordious.Desktop.DiagramFretLabelEditorWindow"
        x:DataType="coreVm:DiagramFretLabelEditorViewModel"
        mc:Ignorable="d"
        d:DesignWidth="860"
        d:DesignHeight="640"
        Width="860"
        Height="640"
        MinWidth="720"
        MinHeight="540"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">
  <Grid RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
    <Border Padding="22,16" Background="{DynamicResource AccentColor100}">
      <StackPanel Spacing="2">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Editor de rótulo de casa" />
        <TextBlock Opacity="0.75"
                   Text="Conteúdo, tipografia e layout usando o ViewModel compartilhado" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="20" Spacing="16">
        <Border Padding="14"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="8">
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="140,*"
                RowSpacing="10"
                ColumnSpacing="10">
            <TextBlock Grid.ColumnSpan="2"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Text="Propriedades" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Texto" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     AutomationProperties.Name="Texto do rótulo de casa"
                     MaxLength="32"
                     Text="{Binding Text, Mode=TwoWay}" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsEnabled="{Binding Style.IsEditable}">
          <Border Padding="14"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Texto do rótulo" />

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Fonte local"
                          IsChecked="{Binding Style.FretLabelFontFamilyIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Fonte" />
                <ComboBox Grid.Column="2"
                          AutomationProperties.Name="Fonte do rótulo de casa"
                          ItemsSource="{Binding Style.FontFamilies}"
                          SelectedItem="{Binding Style.FretLabelFontFamily, Mode=TwoWay}"
                          IsEnabled="{Binding Style.FretLabelFontFamilyIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Estilo local"
                          IsChecked="{Binding Style.FretLabelTextStyleIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Estilo" />
                <ComboBox Grid.Column="2"
                          AutomationProperties.Name="Estilo do texto do rótulo de casa"
                          ItemsSource="{Binding Style.FretLabelTextStyles}"
                          SelectedIndex="{Binding Style.SelectedFretLabelTextStyleIndex, Mode=TwoWay}"
                          IsEnabled="{Binding Style.FretLabelTextStyleIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Cor local"
                          IsChecked="{Binding Style.FretLabelTextColorIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Cor" />
                <TextBox Grid.Column="2"
                         AutomationProperties.Name="Cor do texto do rótulo de casa"
                         PlaceholderText="#RRGGBB"
                         Text="{Binding Style.FretLabelTextColor, Mode=TwoWay}"
                         IsEnabled="{Binding Style.FretLabelTextColorIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Opacidade local"
                          IsChecked="{Binding Style.FretLabelTextOpacityIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Opacidade" />
                <NumericUpDown Grid.Column="2"
                               AutomationProperties.Name="Opacidade do texto do rótulo de casa"
                               Minimum="0"
                               Maximum="1"
                               Increment="0.01"
                               FormatString="0.00"
                               Value="{Binding Style.FretLabelTextOpacity, Mode=TwoWay}"
                               IsEnabled="{Binding Style.FretLabelTextOpacityIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Tamanho local"
                          IsChecked="{Binding Style.FretLabelTextSizeRatioIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Proporção" />
                <NumericUpDown Grid.Column="2"
                               AutomationProperties.Name="Proporção do tamanho do texto do rótulo de casa"
                               Minimum="0"
                               Maximum="2"
                               Increment="0.01"
                               FormatString="0.00"
                               Value="{Binding Style.FretLabelTextSizeRatio, Mode=TwoWay}"
                               IsEnabled="{Binding Style.FretLabelTextSizeRatioIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Largura local"
                          IsChecked="{Binding Style.FretLabelTextWidthRatioIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Proporção" />
                <NumericUpDown Grid.Column="2"
                               AutomationProperties.Name="Proporção da largura do texto do rótulo de casa"
                               Minimum="0"
                               Maximum="2"
                               Increment="0.01"
                               FormatString="0.00"
                               Value="{Binding Style.FretLabelTextWidthRatio, Mode=TwoWay}"
                               IsEnabled="{Binding Style.FretLabelTextWidthRatioIsLocal}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Padding="14"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Spacing="12">
              <TextBlock FontSize="17" FontWeight="SemiBold" Text="Layout do rótulo" />

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Visibilidade local"
                          IsChecked="{Binding Style.FretLabelTextVisibleIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Visível" />
                <CheckBox Grid.Column="2"
                          AutomationProperties.Name="Texto do rótulo de casa visível"
                          IsChecked="{Binding Style.FretLabelTextVisible, Mode=TwoWay}"
                          IsEnabled="{Binding Style.FretLabelTextVisibleIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Alinhamento local"
                          IsChecked="{Binding Style.FretLabelTextAlignmentIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Alinhamento" />
                <ComboBox Grid.Column="2"
                          AutomationProperties.Name="Alinhamento do texto do rótulo de casa"
                          ItemsSource="{Binding Style.FretLabelTextAlignments}"
                          SelectedIndex="{Binding Style.SelectedFretLabelTextAlignmentIndex, Mode=TwoWay}"
                          IsEnabled="{Binding Style.FretLabelTextAlignmentIsLocal}" />
              </Grid>

              <Grid ColumnDefinitions="140,90,*" ColumnSpacing="8">
                <CheckBox Content="Espaçamento local"
                          IsChecked="{Binding Style.FretLabelGridPaddingIsLocal, Mode=TwoWay}" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Pixels" />
                <NumericUpDown Grid.Column="2"
                               AutomationProperties.Name="Espaçamento da grade do rótulo de casa em pixels"
                               Minimum="0"
                               Increment="0.25"
                               FormatString="0.00"
                               Value="{Binding Style.FretLabelGridPadding, Mode=TwoWay}"
                               IsEnabled="{Binding Style.FretLabelGridPaddingIsLocal}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Button Command="{Binding Style.Reset}" Content="Restaurar estilo" />
        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Opacity="0.65"
                   Text="Alterações são aplicadas somente ao confirmar." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button MinWidth="90" Command="{Binding Apply}" Content="Aplicar" />
          <Button MinWidth="90"
                  Command="{Binding Cancel}"
                  Content="Cancelar"
                  IsCancel="True" />
          <Button MinWidth="90"
                  Command="{Binding Accept}"
                  Content="Salvar"
                  IsDefault="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
